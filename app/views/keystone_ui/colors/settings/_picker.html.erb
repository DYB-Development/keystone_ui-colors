<%
  preference = KeystoneUi::Colors::ThemePreference.find_or_initialize_by(owner: person)

  selected_template = preference.template_name
  choice = KeystoneUi::Colors::ColourChoice.new(person: person, account: account)
%>

<%= ui_panel(padding: :lg) do %>
  <%= form_with(
    url: submit_url,
    method: :patch,
    data: { turbo: false, controller: "keystone-ui--colors--theme-settings", selected_template: selected_template }
  ) do |form| %>
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <% if choice.person_chooses? %>
        <%= render partial: "keystone_ui/colors/settings/colours", locals: { preference: preference } %>
      <% end %>

      <%= ui_section(title: "Mode", spacing: :sm) do %>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          <% KeystoneUi::Colors::ThemePreference::MODES.each do |mode| %>
            <% next if mode == "custom" && !(choice.person_chooses? || choice.custom_offered?) %>
            <%= ui_radio_card(name: "mode", value: mode, label: mode.capitalize, checked: (preference.mode || KeystoneUi::Colors.configuration.default_mode) == mode) %>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= ui_button(label: "Save", type: :submit) %>
      </div>
    </div>
  <% end %>
<% end %>
