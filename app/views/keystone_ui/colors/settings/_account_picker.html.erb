<% preference = KeystoneUi::Colors::ThemePreference.find_or_initialize_by(owner: account) %>

<%= ui_panel(padding: :lg) do %>
  <%= form_with(
    url: submit_url,
    method: :patch,
    data: { turbo: false, controller: "keystone-ui--colors--theme-settings", selected_template: preference.template_name }
  ) do |form| %>
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <%= render partial: "keystone_ui/colors/settings/colours", locals: { preference: preference } %>

      <div>
        <%= ui_button(label: "Save", type: :submit) %>
      </div>
    </div>
  <% end %>
<% end %>
